# Copy this file to .env.local and replace the placeholder values.

# Database URL. Local: mongodb://127.0.0.1:27017/mess_management
# Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/mess_management?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/mess_management

# Public URL of the app (no trailing slash). Production example: https://mess.yourcollege.edu
NEXTAUTH_URL=http://localhost:3000

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET=replace-with-a-generated-random-secret

# Used only by `npm run seed`. Set a strong password before running it.
SEED_ADMIN_NAME=Mess Admin
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=

# Optional demo data. Leave false for production; when true, set a unique strong password.
SEED_STUDENT_PASSWORD=
SEED_DEMO_DATA=false
